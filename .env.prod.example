# RIE — production environment. The deploy workflow WRITES /opt/rie/.env on the server from the
# GitHub repository secrets named beside each key, so you do not create this file by hand there.
# For a local run of the same stack, copy it to .env.local (see docker-compose.local.yml).
#
# Generate each secret with:  openssl rand -hex 32

# ── Database ──────────────────────────────────────────────────────────────────
# Letters, digits, - _ . ~ only (it is embedded in a connection URL). Applies only when the
# volume is FIRST created; changing it later needs an ALTER USER in psql as well.
POSTGRES_PASSWORD=change-me                 # secret: POSTGRES_PASSWORD

# ── App secrets (each >= 32 random characters, or the API refuses to start) ───
RIE_APP_ENV=prod
RIE_SECRET_KEY=change-me                    # secret: RIE_SECRET_KEY        (session cookies)
RIE_RAILS_SECRET=change-me                  # secret: RIE_RAILS_SECRET      (provider rails HS256)
# Derives the P_* identity tokens. Set ONCE and keep it — changing it stops new identities
# linking to the ones already stored.
RIE_PSEUDONYM_SECRET=change-me              # secret: RIE_PSEUDONYM_SECRET

# Password of the single ADMIN ("admin") created when the user table is empty. Create the other
# users — including a second ADMIN, payments need two — in Administration.
RIE_BOOTSTRAP_ADMIN_PASSWORD=change-me      # secret: RIE_BOOTSTRAP_ADMIN_PASSWORD

# ── Edge (server only) ────────────────────────────────────────────────────────
# The docker network the CIE stack's Caddy is on.
EDGE_NETWORK=cie-prod_default               # secret: EDGE_NETWORK (optional)
TZ=Africa/Johannesburg
