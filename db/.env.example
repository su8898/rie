# Copy to db/.env and adjust. Compose reads this file; the API reads the variables.
# SQLite is the default when RIE_DATABASE_URL is unset (local runs + tests).
RIE_DATABASE_URL=sqlite:///./rie.db
# RIE_DATABASE_URL=postgresql+psycopg2://rie:rie@localhost:5432/rie

# dev | test | prod. Outside dev/test the API REFUSES to start with default or <32-char secrets,
# and the username==password dev logins are NOT seeded.
RIE_APP_ENV=dev

# Generate each with:  openssl rand -hex 32
RIE_SECRET_KEY=dev-insecure-change-me
RIE_RAILS_SECRET=rie-rails-dev-secret
RIE_PSEUDONYM_SECRET=rie-pseudonym-dev-secret

# prod only: password of the single bootstrapped ADMIN (created when the user table is empty)
RIE_BOOTSTRAP_ADMIN_PASSWORD=
# dev only, optional: force-seed the dev logins even outside dev/test
# RIE_SEED_DEV_USERS=1

# Path to the RAF reference snapshot loaded by db/load_reference.py:
RIE_REFERENCE_DB=./reference.db
RIE_PAGE_SIZE=25
