# Copy to .env and adjust. SQLite is the default when unset.
RIE_DATABASE_URL=sqlite:///./rie.db
# RIE_DATABASE_URL=postgresql+psycopg2://rie:rie@localhost:5432/rie
RIE_SECRET_KEY=dev-insecure-change-me
RIE_RAILS_SECRET=rie-rails-dev-secret
# Path to the RAF reference snapshot loaded by db/load_reference.py:
RIE_REFERENCE_DB=./reference.db
RIE_PAGE_SIZE=25
RIE_APP_ENV=dev
