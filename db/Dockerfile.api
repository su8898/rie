# Multi-stage: stage 1 builds the React SPA, stage 2 runs the API and serves the built SPA,
# the JSON API, and the provider rails from one container. The same image runs the one-shot
# reference loader (compose overrides the command).

# ── stage 1: build the SPA ───────────────────────────────────────────────────
FROM node:20-slim AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

# ── stage 2: the API ─────────────────────────────────────────────────────────
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt psycopg2-binary
COPY engine ./engine
COPY server ./server
COPY db ./db
COPY alembic.ini ./alembic.ini
COPY --from=ui /ui/dist ./ui/dist
EXPOSE 8021
# Healthy means the process answers AND it can reach its database (/healthz reports both).
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6   CMD python -c "import json,sys,urllib.request as u; sys.exit(0 if json.load(u.urlopen('http://127.0.0.1:8021/healthz', timeout=4)).get('db') == 'up' else 1)"
# --proxy-headers: in production the app sits behind a TLS-terminating reverse proxy on a private
# docker network, so trust its X-Forwarded-* headers (scheme and client address).
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8021", "--proxy-headers", "--forwarded-allow-ips", "*"]
